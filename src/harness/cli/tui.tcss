Screen {
    background: $background;
    color: $foreground;
    layout: vertical;
}
#topbar {
    height: 2;
    padding-top: 0;
    color: $text-muted;
    background: $surface;
}
#body { height: 1fr; min-height: 3; }
#chat-pane { width: 4fr; min-width: 20; height: 1fr; }
#flow-pane {
    width: 1fr;
    min-width: 18;
    height: 1fr;
    border-left: solid $border;
    background: $surface;
}
#chat-heading { height: 3; padding: 0 1; }
#chat-title { width: 1fr; height: 3; content-align: left middle; color: $primary; text-style: bold; }
#latest { min-width: 12; height: 3; margin: 0; background: $background; border: none; }
#flow-title { height: 3; padding: 1; color: $primary; text-style: bold; }
#conversation, #flow {
    height: 1fr;
    overflow-x: hidden;
    overflow-y: scroll;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-color: $primary-muted;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}
#conversation { padding: 0 1; }
#flow { padding: 0 1; }
#welcome { height: auto; padding: 1; color: $text-muted; }
.message { height: auto; margin: 0 0 1 0; padding: 0 1; }
.user-message { background: $surface; border-left: solid $primary; }
.command-message { border-left: solid $text-muted; }
.command-message .message-role { color: $text-muted; }
.message-role { height: 1; text-style: bold; color: $primary; }
.message Markdown { height: auto; margin: 0; padding: 0; background: transparent; }
.message MarkdownH1, .message MarkdownH2, .message MarkdownH3 { margin-top: 1; margin-bottom: 0; }
.message MarkdownFence { margin: 1 0; padding: 0 1; }
.flow-entry { height: auto; margin-bottom: 1; }
#flow-empty { height: auto; color: $text-muted; }
#composer { height: 8; padding: 0 1; background: $surface; }
#message-input {
    height: 5;
    min-height: 3;
    border: round $primary-muted;
    background: $background;
    padding: 0 1;
}
#message-input:focus { border: round $primary; }
#actions { height: 3; }
#status { width: 1fr; height: 3; content-align: left middle; overflow: hidden hidden; }
#actions Button { min-width: 10; width: 10; height: 3; margin-left: 1; }
#keys { height: 1; color: $text-muted; background: $surface; }
.compact #topbar { height: 1; }
.compact #composer { height: 6; }
.compact #message-input { height: 3; }
.compact #keys { display: none; }
.compact #chat-heading, .compact #flow-title { height: 1; padding: 0 1; }
.compact #chat-title { height: 1; }
PermissionDialog { align: center middle; }
#permission-dialog {
    width: 74;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}
#permission-title { text-style: bold; color: $primary; margin-bottom: 1; }
#permission-args { color: $text-muted; margin-bottom: 1; }
#permission-actions { height: 3; align: right middle; }
#permission-actions Button { min-width: 12; margin-left: 1; }
#permission-actions #always { min-width: 22; }
.compact #latest { height: 1; min-height: 1; border: none; }
